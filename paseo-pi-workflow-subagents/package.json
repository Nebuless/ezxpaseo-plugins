{
  "name": "paseo-pi-workflow-subagents",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "pi/"
  ],
  "scripts": {
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "test": "node --test shared/*.test.mjs server/*.test.mjs pi/*.test.mjs client/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "dependencies": {
    "@getpaseo/plugin": "0.9.2",
    "pi-extensible-workflows": "5.17.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "24.10.1",
    "@types/react": "~19.2.0",
    "prettier": "3.6.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3"
  }
}
